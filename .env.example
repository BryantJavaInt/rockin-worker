# Copy to .env and fill in what you use. Blank = unset.
#
# Comments live on their own lines on purpose: `docker run --env-file` does not
# support inline comments and would treat them as part of the value.

# GitHub personal access token. Read-only is enough: `public_repo` for public
# repositories, or `repo` (classic) / "Contents: read" + "Metadata: read" (fine-grained) to include private ones.
GITHUB_TOKEN=

# Notion internal integration token. Share the pages you want synced with the integration.
NOTION_TOKEN=

# Optional: also sync Notion page bodies so they are searchable (default true). Costs several API calls per changed page.
# NOTION_SYNC_CONTENT=false

# Needed only for `npm run ask` and `npm run eval`.
ANTHROPIC_API_KEY=

# Optional: enables semantic search (ranking by meaning, fused with the lexical ranking).
# Anthropic offers no embeddings API, so vectors come from Voyage AI. Run `npm run embed` after a sync.
VOYAGE_API_KEY=

# `serve --http` (remote MCP) needs ONE of the two authentication modes below.
#
# 1) Shared token: a long random secret, at least 24 characters. Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
#
# 2) OAuth 2.1: access tokens issued by your authorization server (Keycloak, Auth0, Entra ID, ...).
# The issuer says who signs tokens; the audience is this endpoint's public URL, which tokens must be issued for.
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# MCP_OAUTH_SCOPE=mcp:read
# MCP_OAUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
#
# Requests per client per minute on the HTTP endpoint (0 = no limit).
# MCP_RATE_LIMIT_PER_MINUTE=120

# Optional: export OpenTelemetry traces and metrics. Nothing is exported unless an endpoint is set.
# Standard variables: OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_HEADERS, OTEL_SERVICE_NAME,
# OTEL_METRIC_EXPORT_INTERVAL (ms), OTEL_TRACES_EXPORTER=none, OTEL_METRICS_EXPORTER=none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Optional overrides (defaults shown) ---
# DB_PATH=./data.db
# LOG_DIR=./logs
# SYNC_MAX_PAGES=5
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# EMBEDDING_MODEL=voyage-3.5-lite
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# MCP_ALLOWED_ORIGINS=https://app.example.com,https://other.example.com
# SEMANTIC_MIN_SCORE=0.25   # cosine floor for semantic matches; calibrate for your model
