# Copy to .env and fill in what you use. Blank = unset.
#
# Comments live on their own lines on purpose: `docker run --env-file` does not
# support inline comments and would treat them as part of the value.

# GitHub personal access token. Read-only is enough: `public_repo` for public
# repositories, or `repo` (classic) / "Contents: read" + "Metadata: read" (fine-grained) to include private ones.
GITHUB_TOKEN=

# Notion internal integration token. Share the pages you want synced with the integration.
NOTION_TOKEN=

# Needed only for `npm run ask` and `npm run eval`.
ANTHROPIC_API_KEY=

# Optional: enables semantic search (ranking by meaning, fused with the lexical ranking).
# Anthropic offers no embeddings API, so vectors come from Voyage AI. Run `npm run embed` after a sync.
VOYAGE_API_KEY=

# Required only for `serve --http` (remote MCP): a long random secret, at least 24 characters.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Optional overrides (defaults shown) ---
# DB_PATH=./data.db
# LOG_DIR=./logs
# SYNC_MAX_PAGES=5
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# EMBEDDING_MODEL=voyage-3.5-lite
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# MCP_ALLOWED_ORIGINS=https://app.example.com,https://other.example.com
# SEMANTIC_MIN_SCORE=0.25   # cosine floor for semantic matches; calibrate for your model
